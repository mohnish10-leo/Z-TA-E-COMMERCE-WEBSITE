generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  tagline     String
  description String
  price       Float
  image       String
  variants    Variant[]
  scentNotes  ScentNote[]
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  size      String
  price     Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ScentNote {
  id        String  @id @default(cuid())
  productId String
  type      String
  name      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}
